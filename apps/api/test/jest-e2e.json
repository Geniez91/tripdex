{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "useESM": true, "tsconfig": "tsconfig.test.json" }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" }
}
