
model User {
  id        String @id @default(uuid())
  supabaseAuthId Uuid? @unique
  email     String @unique
  username  String @unique
  avatarUrl String?
  bio       String?
  residenceCountryId String?
  residenceCountry Country? @relation(fields: [residenceCountryId], references: [id], onDelete: SetNull)

  trips Trip[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([residenceCountryId])
}

model Country {
  id            String @id @default(uuid())
  iso2          String @unique
  iso3          String @unique
  name          String
  slug          String @unique
  continentCode String

  cities        City[]
  tripCountries TripCountry[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model City {
  id        String @id @default(uuid())
  countryId String

  name      String
  slug      String
  latitude  Float
  longitude Float

  country   Country    @relation(fields: [countryId], references: [id])
  tripCities TripCity[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([countryId, slug])
  @@index([countryId])
}

enum trip_visibility {
  @@type("pg/text@1")

  public  = "public"
  private = "private"
}

model Trip {
  id     String @id @default(uuid())
  userId String

  title     String
  startDate TimestamptzString
  endDate   TimestamptzString?
  visibility trip_visibility @default(private)

  rating Float?
  review String?
  coverStoragePath String?

  user      User          @relation(fields: [userId], references: [id])
  countries TripCountry[]
  cities    TripCity[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([userId])
  @@index([userId, startDate, id])
}

model TripCountry {
  tripId    String
  countryId String
  position  Int

  arrivalDate   TimestamptzString?
  departureDate TimestamptzString?

  trip    Trip    @relation(fields: [tripId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@id([tripId, countryId])
  @@unique([tripId, position])
  @@index([countryId])
}

model TripCity {
  tripId String
  cityId String

  arrivalDate   TimestamptzString?
  departureDate TimestamptzString?

  trip Trip @relation(fields: [tripId], references: [id])
  city City @relation(fields: [cityId], references: [id])

  @@id([tripId, cityId])
  @@index([cityId])
}

enum photo_contest_status {
  @@type("pg/text@1")
  OPEN = "OPEN"
  CLOSED = "CLOSED"
}

model PhotoContest {
  id String @id @default(uuid())
  weeklyPeriod String? @unique
  countryId String
  startsAt TimestamptzString
  endsAt TimestamptzString
  status photo_contest_status @default(OPEN)
  winnerSubmissionId String?
  createdAt TimestamptzString @default(now())
  country Country @relation(fields: [countryId], references: [id])
  winner PhotoContestSubmission? @relation(fields: [winnerSubmissionId], references: [id])
  @@index([countryId, endsAt, id])
  @@index([startsAt, id])
  @@check(expression: "\"startsAt\" < \"endsAt\"", name: "photo_contest_period")
}

model PhotoContestSubmission {
  id String @id @default(uuid())
  contestId String
  userId String
  tripId String
  coverStoragePath String
  createdAt TimestamptzString @default(now())
  contest PhotoContest @relation(fields: [contestId], references: [id])
  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])
  @@unique([contestId, userId])
  @@unique([contestId, id])
  @@index([tripId, coverStoragePath])
}

model PhotoContestVote {
  id String @id @default(uuid())
  contestId String
  userId String
  submissionId String
  createdAt TimestamptzString @default(now())
  contest PhotoContest @relation(fields: [contestId], references: [id])
  user User @relation(fields: [userId], references: [id])
  submission PhotoContestSubmission @relation(fields: [contestId, submissionId], references: [contestId, id])
  @@unique([contestId, userId])
  @@index([submissionId])
}
