# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Required for direct starts and the seed; start:dev/start:prod set their own mode.
NODE_ENV=development
# Temporary local identity; only allowed in development/test with explicit opt-in.
DEV_AUTH_ENABLED=true

# API only. Never copy the service-role key into Nuxt or Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TRIP_COVERS_BUCKET=trip-covers
