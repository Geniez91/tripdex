{
  "name": "tripdex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "rxjs": "7.8.2"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace=api",
    "format:check": "npm run format:check --workspace=web",
    "test": "npm run test --workspace=api -- --runInBand",
    "db:seed": "npm run db:seed --workspace=api",
    "db:verify": "npm run db:verify --workspace=api",
    "data:prepare": "node scripts/prepare-geography.mjs"
  }
}
